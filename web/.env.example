# Contact / quote recipient addresses (used to build mailto: links).
# These end up in the client bundle (a mailto address is public by nature),
# but are kept configurable here and injected from CI secrets at build time.
NEXT_PUBLIC_CONTACT_EMAIL_MARENNES=marennes@ets-bertrand.com
NEXT_PUBLIC_CONTACT_EMAIL_GUJAN=gujan@ets-bertrand.com
# "No preference" sends to Marennes with Gujan in cc. Override defaults if needed:
# NEXT_PUBLIC_CONTACT_EMAIL_DEFAULT=marennes@ets-bertrand.com

# Site base URL (for canonical / sitemap / og:url)
NEXT_PUBLIC_SITE_URL=https://ets-bertrand.com
